<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <RootNamespace>CHDSharpEncoder</RootNamespace>
        <!-- SharpCompress >= 0.48 replaced the LZMA stream API with factory methods
             (LzmaStream.Create) but still produces raw headerless LZMA when the end-marker
             flag is off, which is what CHD stores; validated by the chdman LZMA suites. -->
    </PropertyGroup>

<ItemGroup>
        <InternalsVisibleTo Include="CHDSharpEncoderTest" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CHDSharpLib\CHDSharpLib.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="SharpCompress" Version="0.50.4" />
      <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
      <PackageReference Update="Meziantou.Analyzer" Version="3.0.163">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

</Project>


